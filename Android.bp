android_app_import {
    name: "FuryOSLABs",
    apk: "out/FuryOSLABs.apk",
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,
    required: ["privapp_whitelist_jiro.furyos.labs.xml"],
}

prebuilt_etc {
    name: "privapp_whitelist_jiro.furyos.labs.xml",
    sub_dir: "permissions",
    src: "permissions/privapp_whitelist_jiro.furyos.labs.xml",
    system_ext_specific: true,
}
